---
export interface ArticleSearchItem {
  slug: string;
  title: string;
  description: string;
  category: string;
  categoryLabel: string;
  tags: string[];
  date: string;
  bodyText?: string;
}

interface Props {
  article: ArticleSearchItem;
}

import { categoryLabel } from '../lib/site.mjs';

const { article } = Astro.props;

const dateLabel = new Date(article.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="article-card" href={`/library/articles/${article.slug}/`} data-testid="article-card">
  <span class="pill">{categoryLabel(article.category)}</span>
  <h3 class="title">{article.title}</h3>
  <p class="description">{article.description}</p>
  <div class="meta">
    <time datetime={article.date}>{dateLabel}</time>
    <span class="tags" aria-label={`Tags: ${article.tags.join(', ')}`}>
      {(article.tags ?? []).map((tag) => <span class="tag">#{tag}</span>)}
    </span>
  </div>
</a>

<style>
  .article-card {
    display: block;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: linear-gradient(160deg, var(--surface), #0c1322);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    color: var(--text);
  }
  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
    text-decoration: none;
  }
  .title {
    margin: 0.7rem 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .article-card:hover .title {
    color: var(--accent);
  }
  .description {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .meta {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .tags {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tag {
    color: var(--teal);
    font-weight: 600;
  }
  .title :global(mark) {
    background: rgba(122, 162, 255, 0.32);
    color: #dbe7ff;
    border-radius: 0.25rem;
    padding: 0 0.15rem;
  }
</style>