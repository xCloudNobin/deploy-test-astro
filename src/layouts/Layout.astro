---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">deploy-test-astro</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Built with Astro for Git deployment testing.</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: #080b12;
    color: #e8ecf5;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  header, main, footer {
    width: min(920px, calc(100% - 2rem));
    margin-inline: auto;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
  }

  nav { display: flex; gap: 1rem; }
  a { color: #8ab4ff; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .brand { color: #fff; font-weight: 700; }

  main {
    display: grid;
    place-items: center;
    padding: 4rem 0;
  }

  .card {
    width: 100%;
    padding: clamp(2rem, 6vw, 5rem);
    border: 1px solid #26314a;
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #111827, #0c1220);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
  }

  .eyebrow {
    color: #8ab4ff;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  h1 { margin: .5rem 0 1rem; font-size: clamp(2.5rem, 8vw, 5rem); line-height: 1; }
  p { color: #b9c2d6; font-size: 1.1rem; line-height: 1.7; }
  .button {
    display: inline-block;
    margin-top: 1rem;
    padding: .8rem 1.1rem;
    border-radius: .65rem;
    background: #3977e8;
    color: white;
    font-weight: 700;
  }

  footer { padding: 1.5rem 0; color: #74809a; font-size: .9rem; }
</style>
