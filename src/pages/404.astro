---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Field Notes" description="This page does not exist.">
  <div class="not-found">
    <p class="eyebrow">404</p>
    <h1>This note does not exist.</h1>
    <p>
      The page may have been renamed or never written. The library is a good place to search.
    </p>
    <div class="actions">
      <a class="button" href="/library/">Search the library</a>
      <a class="button secondary" href="/">Go home</a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 3rem 1rem;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
  }
  h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    letter-spacing: -0.02em;
  }
  p {
    color: var(--muted);
    max-width: 46ch;
    margin: 0 auto 1.6rem;
    line-height: 1.7;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
</style>