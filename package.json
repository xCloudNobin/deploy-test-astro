{
  "name": "deploy-test-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Field Notes — a small static knowledge/library site built with Astro: content collections, nested routes, category filters and client-side search.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:info": "node scripts/build-info.mjs",
    "build": "npm run build:info && astro build",
    "dev": "npm run build:info && astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "check": "npm run build:info && astro check",
    "test:unit": "npm run build:info && node --test \"tests/unit/*.test.mjs\"",
    "test:smoke": "node scripts/smoke.mjs",
    "test": "npm run test:unit && npm run test:smoke",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}